{
  "version": 2,
  "builds": [
    {
      "src": "api/deploy.py",
      "use": "@vercel/python"
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/deploy.py"
    },
    {
      "src": "/(.*)",
      "dest": "/static/index.html"
    }
  ],
  "env": {
    "MASTER_PRIVATE_KEY": "@master_private_key"
  }
}
